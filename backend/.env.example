# ─── Backend Environment Variables ────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# NEVER commit .env — only commit this .env.example file.

# A long, random secret used to sign JWT tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-super-secret-key-change-me-in-production

# JWT signing algorithm (HS256 is the standard default)
ALGORITHM=HS256

# How long (in minutes) a login token stays valid
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database connection string.
# Local dev (SQLite):   sqlite:///./adaptive_fitness.db
# Production (Render):  postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./adaptive_fitness.db

# Comma-separated list of frontend origins allowed to call this API.
# Local dev:   http://localhost:5173,http://localhost:3000
# Production:  https://fit.alphazero.dev
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Gemini API key for AI-powered calorie estimation.
# Get yours at: https://aistudio.google.com/app/apikey
# Leave blank to fall back to the built-in keyword-based estimator.
GEMINI_API_KEY=your-gemini-api-key-here
